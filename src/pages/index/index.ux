.red { color:#a52022; }
.black { color:#182728; }
.empty { background-color:transparent; border-color:transparent; color:#17674c; font-size:32px; }
.last { border-color:#447aa0; }
.legal { border-color:#268562; }
.selected { border-color:#e49b19; background-color:#ffda78; }
